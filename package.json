{
  "name": "zeni-pets-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:docker:up": "docker compose up -d postgres",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:staging": "tsx scripts/seed-import-staging.ts",
    "db:setup": "npm run db:docker:up && npm run db:migrate && npm run db:seed && npm run db:seed:staging",
    "db:audit:reservation-status": "tsx prisma/scripts/audit/reservation-status-fix.ts",
    "db:fix:reservation-status": "tsx prisma/scripts/audit/reservation-status-fix.ts --apply",
    "db:services:dedupe": "tsx scripts/consolidate-service-types.ts",
    "db:services:dedupe:apply": "tsx scripts/consolidate-service-types.ts --apply",
    "import:preview": "tsx scripts/import-preview.ts",
    "import:audit": "tsx scripts/generate-audit-report.ts",
    "import:decisions": "tsx scripts/read-import-decisions.ts",
    "import:dry-run": "tsx scripts/import-dry-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "fast-xml-parser": "^5.7.2",
    "googleapis": "^171.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.11.0",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
