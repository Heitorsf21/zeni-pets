// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF
}

enum TutorStatus {
  ACTIVE
  INACTIVE
}

enum ServiceKind {
  BOARDING
  DAYCARE
  PET_SITTING
  DOG_WALKER
  TAXI_PET
  ADAPTATION
  OTHER
}

enum ReservationStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PickupMode {
  TUTOR_DROPS_OFF
  ZENI_PICKUP
}

enum FinancialEntryKind {
  INCOME
  EXPENSE
}

enum ImportBatchStatus {
  PENDING_REVIEW
  REVIEWING
  APPROVED
  REJECTED
}

enum ImportRecordStatus {
  PENDING_REVIEW
  NEEDS_REVIEW
  APPROVED
  REJECTED
  IMPORTED
}

enum ImportSourceKind {
  PRICE_SHEET
  CLIENTS_2025
  CLIENTS_2026
  CLIENT_FORM_DOCX
  UNKNOWN
}

enum ImportDetectedType {
  SERVICE_PRICE
  TAXI_RULE
  HISTORICAL_RESERVATION
  DAYCARE_RESERVATION
  FINANCIAL_ENTRY
  FINANCIAL_SUMMARY
  CLIENT_FORM
  UNKNOWN
}

enum ImportConflictType {
  DUPLICATE_TUTOR
  DUPLICATE_PET
  FIELD_MISMATCH
  GOOGLE_EVENT
  DIVERGENT_SOURCE
  UNKNOWN
}

enum ImportConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum ImportResolutionAction {
  APPROVE
  REJECT
  MERGE_TUTOR
  MERGE_PET
  CORRECT_FIELD
  IMPORT_RECORD
  IGNORE
}

enum FinancialSummaryKind {
  MONTHLY_CLOSING
  OPERATIONAL_TOTAL
}

enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

enum TaskSource {
  MANUAL
  RESERVATION_DAILY
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  username     String?  @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tutor {
  id                   String        @id @default(uuid())
  name                 String
  email                String?
  phone                String?
  document             String?
  birthDate            DateTime?
  address              String?
  cep                  String?
  notes                String?
  status               TutorStatus   @default(ACTIVE)
  importRecordId       String?
  importRecord         ImportRecord? @relation("TutorImportSource", fields: [importRecordId], references: [id], onDelete: SetNull)
  sourceFileName       String?
  sourceSheet          String?
  sourceRow            Int?
  sourceBlock          Int?
  sourcePayload        Json?
  mergedFromIds        String[]      @default([])
  mergedSourcePayloads Json?
  pets                 Pet[]
  reservations         Reservation[]
  tasks                Task[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Pet {
  id                   String           @id @default(uuid())
  tutorId              String
  tutor                Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  name                 String
  species              String           @default("dog")
  breed                String?
  ageLabel             String?
  birthDate            DateTime?
  weightKg             Float?
  isNeutered           Boolean?
  isSociable           Boolean?
  foodNotes            String?
  healthNotes          String?
  behaviorNotes        String?
  vetName              String?
  vetPhone             String?
  deliveredItems       String?
  importRecordId       String?
  importRecord         ImportRecord?    @relation("PetImportSource", fields: [importRecordId], references: [id], onDelete: SetNull)
  sourceFileName       String?
  sourceSheet          String?
  sourceRow            Int?
  sourceBlock          Int?
  sourcePayload        Json?
  mergedFromIds        String[]         @default([])
  mergedSourcePayloads Json?
  reservationPets      ReservationPet[]
  tasks                Task[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model ServiceType {
  id           String             @id @default(uuid())
  name         String
  kind         ServiceKind
  description  String?
  isActive     Boolean            @default(true)
  priceRules   ServicePriceRule[]
  reservations Reservation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ServicePriceRule {
  id                        String        @id @default(uuid())
  serviceTypeId             String
  serviceType               ServiceType   @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  label                     String
  paymentMethod             PaymentMethod
  firstPetCents             Int
  additionalPetCents        Int?
  highSeasonFirstPetCents   Int?
  highSeasonAdditionalCents Int?
  fixedFeeCents             Int?
  perKmCents                Int?
  hygieneFeeCents           Int?
  isActive                  Boolean       @default(true)
  importRecordId            String?
  importRecord              ImportRecord? @relation("ServicePriceImportSource", fields: [importRecordId], references: [id], onDelete: SetNull)
  sourceFileName            String?
  sourceSheet               String?
  sourceRow                 Int?
  sourceBlock               Int?
  sourcePayload             Json?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@unique([serviceTypeId, label, paymentMethod])
}

model SeasonPeriod {
  id        String   @id @default(uuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, startsAt, endsAt])
}

model Reservation {
  id                    String            @id @default(uuid())
  tutorId               String
  tutor                 Tutor             @relation(fields: [tutorId], references: [id])
  serviceTypeId         String
  serviceType           ServiceType       @relation(fields: [serviceTypeId], references: [id])
  status                ReservationStatus @default(REQUESTED)
  paymentStatus         PaymentStatus     @default(PENDING)
  pickupMode            PickupMode        @default(TUTOR_DROPS_OFF)
  startsAt              DateTime
  endsAt                DateTime
  actualEndedAt         DateTime?
  notes                 String?
  privateNotes          String?
  inviteTutor           Boolean           @default(false)
  baseAmountCents       Int               @default(0)
  discountCents         Int               @default(0)
  additionalCents       Int               @default(0)
  taxiPetCents          Int               @default(0)
  lateFeeCents          Int               @default(0)
  totalCents            Int               @default(0)
  depositSuggestedCents Int               @default(0)
  depositDueCents       Int               @default(0)
  balanceDueCents       Int               @default(0)
  googleCalendarId      String?
  googleEventId         String?
  googleEventEtag       String?
  googleLastSyncedAt    DateTime?
  syncConflict          Boolean           @default(false)
  syncConflictReason    String?
  importRecordId        String?
  importRecord          ImportRecord?     @relation("ReservationImportSource", fields: [importRecordId], references: [id], onDelete: SetNull)
  sourceFileName        String?
  sourceSheet           String?
  sourceRow             Int?
  sourceBlock           Int?
  sourcePayload         Json?
  reservationPets       ReservationPet[]
  payments              Payment[]
  financialEntries      FinancialEntry[]
  tasks                 Task[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model ReservationPet {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  petId         String
  pet           Pet         @relation(fields: [petId], references: [id])
  priceRole     String?
  createdAt     DateTime    @default(now())

  @@unique([reservationId, petId])
}

model Payment {
  id             String        @id @default(uuid())
  reservationId  String
  reservation    Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amountCents    Int
  method         PaymentMethod
  status         PaymentStatus @default(PAID)
  paidAt         DateTime?
  notes          String?
  importRecordId String?
  importRecord   ImportRecord? @relation("PaymentImportSource", fields: [importRecordId], references: [id], onDelete: SetNull)
  sourceFileName String?
  sourceSheet    String?
  sourceRow      Int?
  sourceBlock    Int?
  sourcePayload  Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model FinancialEntry {
  id             String             @id @default(uuid())
  reservationId  String?
  reservation    Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  kind           FinancialEntryKind
  category       String
  description    String?
  entryDate      DateTime
  amountCents    Int
  method         PaymentMethod?
  isManual       Boolean            @default(false)
  importRecordId String?
  importRecord   ImportRecord?      @relation("FinancialEntryImportSource", fields: [importRecordId], references: [id], onDelete: SetNull)
  sourceFileName String?
  sourceSheet    String?
  sourceRow      Int?
  sourceBlock    Int?
  sourcePayload  Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model FinancialSummary {
  id             String               @id @default(uuid())
  kind           FinancialSummaryKind @default(MONTHLY_CLOSING)
  year           Int
  month          Int
  label          String
  totalCents     Int
  notes          String?
  importRecordId String?
  importRecord   ImportRecord?        @relation("FinancialSummaryImportSource", fields: [importRecordId], references: [id], onDelete: SetNull)
  sourceFileName String?
  sourceSheet    String?
  sourceRow      Int?
  sourceBlock    Int?
  sourcePayload  Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([kind, year, month, label])
}

model Task {
  id            String           @id @default(uuid())
  title         String
  description   String?
  taskDate      DateTime
  endsAt        DateTime?
  status        TaskStatus       @default(PENDING)
  source        TaskSource       @default(MANUAL)
  reservationId String?
  reservation   Reservation?     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tutorId       String?
  tutor         Tutor?           @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  petId         String?
  pet           Pet?             @relation(fields: [petId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  occurrences   TaskOccurrence[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([taskDate, status])
}

model TaskOccurrence {
  id             String     @id @default(uuid())
  taskId         String
  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  status         TaskStatus @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([taskId, occurrenceDate])
  @@index([occurrenceDate, status])
}

model BusinessSettings {
  id                   String   @id @default(uuid())
  singletonKey         String   @unique @default("default")
  businessName         String   @default("Zeni Pets")
  ownerName            String   @default("Fernanda Zeni")
  phone                String?
  instagram            String?
  address              String?
  boardingCapacity     Int      @default(12)
  daycareCapacity      Int      @default(8)
  defaultCheckInTime   String   @default("10:00")
  defaultCheckOutTime  String   @default("18:00")
  lateFeeOnePetCents   Int      @default(1000)
  lateFeeManyPetsCents Int      @default(1500)
  depositPercent       Int      @default(50)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model GoogleCalendarConnection {
  id                     String    @id @default(uuid())
  providerAccountEmail   String?
  accessTokenCipher      String?
  refreshTokenCipher     String?
  scopes                 String?
  googleCalendarId       String?
  googleSyncToken        String?
  googleChannelId        String?
  googleResourceId       String?
  googleChannelExpiresAt DateTime?
  lastSyncedAt           DateTime?
  connectedAt            DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model ImportBatch {
  id          String             @id @default(uuid())
  fileName    String
  sourceKind  ImportSourceKind   @default(UNKNOWN)
  status      ImportBatchStatus  @default(PENDING_REVIEW)
  notes       String?
  records     ImportRecord[]
  conflicts   ImportConflict[]
  resolutions ImportResolution[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([fileName, sourceKind])
}

model ImportRecord {
  id                 String             @id @default(uuid())
  batchId            String
  batch              ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceSheet        String?
  sourceRow          Int?
  sourceBlock        Int?
  rawPayload         Json
  normalizedPayload  Json?
  detectedType       ImportDetectedType @default(UNKNOWN)
  confidence         Float              @default(0)
  status             ImportRecordStatus @default(PENDING_REVIEW)
  reviewNotes        String?
  conflicts          ImportConflict[]
  resolutions        ImportResolution[]
  tutors             Tutor[]            @relation("TutorImportSource")
  pets               Pet[]              @relation("PetImportSource")
  servicePrices      ServicePriceRule[] @relation("ServicePriceImportSource")
  reservations       Reservation[]      @relation("ReservationImportSource")
  payments           Payment[]          @relation("PaymentImportSource")
  financialEntries   FinancialEntry[]   @relation("FinancialEntryImportSource")
  financialSummaries FinancialSummary[] @relation("FinancialSummaryImportSource")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ImportConflict {
  id             String               @id @default(uuid())
  batchId        String?
  batch          ImportBatch?         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceRecordId String?
  sourceRecord   ImportRecord?        @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  type           ImportConflictType   @default(UNKNOWN)
  status         ImportConflictStatus @default(OPEN)
  title          String
  description    String?
  payload        Json?
  resolutions    ImportResolution[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, type])
}

model ImportResolution {
  id             String                 @id @default(uuid())
  batchId        String?
  batch          ImportBatch?           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  conflictId     String?
  conflict       ImportConflict?        @relation(fields: [conflictId], references: [id], onDelete: SetNull)
  sourceRecordId String?
  sourceRecord   ImportRecord?          @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  action         ImportResolutionAction
  targetModel    String?
  targetId       String?
  payload        Json?
  notes          String?
  createdAt      DateTime               @default(now())
}

model DedupeCandidate {
  id           String   @id @default(uuid())
  type         String
  groupKey     String
  confidence   Float    @default(0)
  status       String   @default("OPEN")
  canonicalId  String?
  candidateIds String[] @default([])
  summary      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, status])
  @@index([groupKey])
}

model DedupeAuditLog {
  id          String   @id @default(uuid())
  type        String
  canonicalId String
  mergedIds   String[] @default([])
  performedBy String?
  summary     Json
  performedAt DateTime @default(now())

  @@index([type, performedAt])
  @@index([canonicalId])
}
